<resources>
    <!-- Base application theme. -->
    <style name="Theme.HookIntent" parent="Theme.HookIntent.Base" />
    <style name="Theme.HookIntent.Base" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/screen_bg</item>
        <item name="colorOnSurface">@color/screen_text</item>
        <item name="colorOnBackground">@color/screen_text</item>
        <item name="android:textColorPrimary">@color/screen_text</item>
        <item name="android:textColorSecondary">@color/screen_secondary</item>
        <item name="android:textColorHint">@color/screen_hint</item>
        <item name="android:textColorLink">@color/screen_accent</item>
        <item name="android:navigationBarColor">@color/screen_primary</item>
        <item name="colorControlNormal">@color/screen_secondary</item>
        <item name="colorControlActivated">@color/screen_control_active</item>
        <item name="actionOverflowButtonStyle">@style/OverflowButton</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="colorPrimary">@color/screen_primary</item>
        <item name="colorPrimaryVariant">@color/screen_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/screen_control_active</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.HookIntent.NoActionBar" mce_bogus="1">
        <item name="android:windowAnimationStyle">@style/AnimationActivity</item>
        <item name="android:windowNoTitle">true</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HookIntent.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.HookIntent.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomNavigationMenu" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item> <!-- 调整字体大小 -->
        <item name="android:textColor">@color/screen_secondary</item> <!-- 字体颜色设置为灰色 -->
        <item name="android:textStyle">normal</item> <!-- 正常字体（取消加粗） -->
    </style>

    <style name="RoundedTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <!-- 设置边框颜色 -->
        <item name="boxStrokeColor">@color/teal_700</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>

        <!-- 设置内部背景颜色 -->
        <item name="boxBackgroundColor">@color/screen_bg</item>

        <!-- 启用外框模式 -->
        <item name="boxBackgroundMode">outline</item>

        <!-- 设置圆角 -->
        <item name="shapeAppearance">@style/RoundedCornersShape</item>
    </style>

    <!-- 定义圆角形状 -->
    <style name="RoundedCornersShape" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>


    <style name="AnimationActivity" mce_bogus="1" parent="@android:style/Animation.Activity">
        <!-- 打开新 Activity 时 -->
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item> <!-- 从右侧滑入 -->
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left
        </item> <!-- 当前 Activity 滑出到左侧 -->

        <!-- 关闭当前 Activity 时 -->
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left
        </item> <!-- 返回时，新 Activity 从左侧滑入 -->
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right
        </item> <!-- 当前 Activity 滑出到右侧 -->

        <!-- 窗口级动画 -->
        <!--        <item name="android:windowEnterAnimation">@anim/slide_out_left</item>-->
        <!--        <item name="android:windowExitAnimation">@anim/slide_in_right</item>-->

    </style>

    <style name="TransparentActivity" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 设置窗口为透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>


</resources>
