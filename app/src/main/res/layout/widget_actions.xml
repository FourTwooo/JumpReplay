<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
        <StackView android:id="@+id/action_stack" android:layout_width="match_parent" android:layout_height="match_parent"
            android:loopViews="true" android:animateLayoutChanges="false" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:background="@drawable/widget_card_background" android:padding="16dp"
            android:text="@string/action_widget_empty" android:textColor="@color/screen_text" android:textSize="14sp" />
        <ImageButton android:id="@+id/widget_configure" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="top|end" android:padding="7dp" android:src="@drawable/widget_edit"
            android:background="@drawable/widget_card_background" android:contentDescription="@string/action_widget_configure" />
</FrameLayout>
