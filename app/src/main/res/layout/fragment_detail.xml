<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/screen_bg">
    <TextView android:id="@+id/urlTextView" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:padding="12dp" android:textSize="13sp"
        android:fontFamily="monospace" android:textColor="@color/screen_text"
        android:background="@color/screen_code" android:breakStrategy="simple"
        android:hyphenationFrequency="none" android:lineSpacingExtra="3dp"
        android:maxLines="4" android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/detail_replay_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="3dp"
        android:paddingBottom="12dp"
        android:textColor="@color/screen_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/urlTextView" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="@color/screen_bg" app:tabTextColor="@color/screen_secondary"
        app:tabSelectedTextColor="@color/screen_accent" app:tabIndicatorColor="@color/screen_accent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_replay_status" />
    <FrameLayout android:id="@+id/contentFrame" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" app:layout_constraintBottom_toBottomOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/dataRecyclerView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingBottom="16dp" android:clipToPadding="false" />
        <TextView android:id="@+id/tabTextView" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_margin="12dp"
            android:background="@color/screen_code" android:textColor="@color/screen_text"
            android:padding="14dp" android:fontFamily="monospace" android:textSize="12sp"
            android:breakStrategy="simple" android:hyphenationFrequency="none" android:lineSpacingExtra="4dp"
            android:gravity="start" android:scrollbars="vertical" android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
