<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/widget_card_background"
    android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal">
    <CheckBox android:id="@+id/action_selected" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" />
    <ImageView android:id="@+id/action_icon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp" android:layout_marginEnd="4dp">
        <TextView android:id="@+id/action_name_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/screen_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/action_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/screen_secondary" android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/action_run" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/action_play" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="执行动作" />
    <ImageButton android:id="@+id/action_drag" android:layout_width="40dp" android:layout_height="48dp"
        android:src="@drawable/action_drag" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="拖动排序" />
</LinearLayout>
